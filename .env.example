# --- Database (local SQLite file; use a libsql:// Turso URL + token in production)
DATABASE_URL=file:./data/leaderboard.db
DATABASE_AUTH_TOKEN=

# --- Admin access
ADMIN_PASSWORD=change-me
SESSION_SECRET=
CRON_SECRET=

# --- Zoho Books
ZOHO_MODE=live
ZOHO_ORG_ID=714292728
ZOHO_ALLOWED_ORG_IDS=714292728
ZOHO_DRY_RUN=false
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_BASE=https://www.zohoapis.com/books/v3
# Self Client from https://api-console.zoho.com, scope: ZohoBooks.invoices.READ,ZohoBooks.settings.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Background sync while the server runs (minutes, 0 = off)
AUTO_SYNC_MINUTES=15
